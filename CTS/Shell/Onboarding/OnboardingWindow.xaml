<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:CircleToSearch.Ui" xmlns:effects="clr-namespace:CircleToSearch.Ui.Effects" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" Background="{DynamicResource SettingsPaper}" Foreground="{DynamicResource SettingsText}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsPreview/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TextButton" TargetType="Button">
                <Setter Property="effects:ControlRippleHost.IsEnabled" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
                <Setter Property="Background" Value="{DynamicResource SettingsTransparent}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7">
                                <Border x:Name="Hover" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="{DynamicResource SettingsHover}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Background" Value="{DynamicResource SettingsSelected}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Setter Property="Background" Value="{DynamicResource SettingsAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnboardingOnAccent}"/>
                <Setter Property="Padding" Value="16,8"/>
            </Style>
            <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Setter Property="Foreground" Value="{DynamicResource SettingsAccent}"/>
            </Style>
            <Style x:Key="Check" TargetType="CheckBox">
                <Setter Property="effects:ControlRippleHost.IsEnabled" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Chrome" CornerRadius="7" Background="{DynamicResource SettingsTransparent}" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="18" Height="18">
                                        <Border x:Name="Outline" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource SettingsMuted}"/>
                                        <Border x:Name="Fill" CornerRadius="4" Background="{DynamicResource SettingsAccent}" Visibility="Hidden">
                                            <Viewbox Width="14" Height="14">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{x:Static ui:PluginIcons.CheckOutlined}" Stroke="{DynamicResource OnboardingOnAccent}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsHover}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Outline" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StepDot" TargetType="Button">
                <Setter Property="Padding" Value="3,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource SettingsTransparent}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Keycap" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SettingsSelected}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OnboardingKeycapBorder}"/>
            </Style>
            <Style x:Key="SampleScreen" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource OnboardingScreenSurface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OnboardingScreenBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>
            <Style x:Key="Floating" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource OnboardingToolbarSurface}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="{DynamicResource OnboardingShadowColor}" Direction="270" ShadowDepth="6" BlurRadius="18" Opacity="0.4"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HintChip" TargetType="Border" BasedOn="{StaticResource Floating}">
                <Setter Property="Background" Value="{DynamicResource OnboardingChipSurface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OnboardingChipBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="10,6,12,6"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ChipLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource OnboardingChipText}"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>
            <Style x:Key="ScreenBar" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource OnboardingScreenLine}"/>
                <Setter Property="Height" Value="6"/>
                <Setter Property="CornerRadius" Value="3"/>
            </Style>
            <Style x:Key="StepTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="StepText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="LineHeight" Value="19"/>
                <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,8,0,0"/>
            </Style>
            <DataTemplate x:Key="SampleSelection">
                <Canvas Width="212" Height="176">
                    <Border Style="{StaticResource ScreenBar}" Canvas.Left="115" Canvas.Top="17" Width="82" Height="8" CornerRadius="4" Background="{DynamicResource OnboardingScreenHeading}"/>
                    <Border Style="{StaticResource ScreenBar}" Canvas.Left="115" Canvas.Top="33" Width="70"/>
                    <Border Style="{StaticResource ScreenBar}" Canvas.Left="115" Canvas.Top="45" Width="78"/>
                    <Border Style="{StaticResource ScreenBar}" Canvas.Left="115" Canvas.Top="57" Width="60"/>
                    <Border Style="{StaticResource ScreenBar}" Canvas.Left="13" Canvas.Top="115" Width="184"/>
                    <Border Style="{StaticResource ScreenBar}" Canvas.Left="13" Canvas.Top="127" Width="150"/>
                    <Border Width="212" Height="176" CornerRadius="9" Background="{DynamicResource OnboardingScreenDim}"/>
                    <Border Canvas.Left="13" Canvas.Top="13" Width="90" Height="90" CornerRadius="8" Background="{DynamicResource OnboardingScreenSelection}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource OnboardingGlowColor}" ShadowDepth="0" BlurRadius="14" Opacity="0.5"/>
                        </Border.Effect>
                    </Border>
                    <Image Canvas.Left="13" Canvas.Top="13" Width="90" Height="90" Source="{DynamicResource TwinDrillEgg}"/>
                    <Border Canvas.Left="13" Canvas.Top="13" Width="90" Height="90" CornerRadius="8" BorderThickness="2.5" BorderBrush="{DynamicResource OnboardingScreenSelection}"/>
                </Canvas>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Width="520" Background="{DynamicResource SettingsPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="250"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Illustration" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush MappingMode="Absolute" StartPoint="126,-81" EndPoint="394,331">
                    <GradientStop Color="{DynamicResource SettingsHeroStartColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource SettingsHeroEndColor}" Offset="0.714"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel x:Name="Step1Art" HorizontalAlignment="Center" Margin="0,84,0,0">
                <Grid Height="55" HorizontalAlignment="Center">
                    <ItemsControl x:Name="HotkeyKeys" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Plus" Text="{Binding Plus}" FontSize="18" Foreground="{DynamicResource SettingsMuted}" Margin="10,0" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Keycap}" BorderThickness="1,1,1,3" CornerRadius="10" Padding="18,0" Height="55" MinWidth="55">
                                        <TextBlock Text="{Binding Label}" FontSize="22" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasSeparator}" Value="False">
                                        <Setter TargetName="Plus" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RecordingPrompt" Text="{Binding [press_shortcut]}" FontSize="18" Foreground="{DynamicResource SettingsMuted}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
                <Button x:Name="ChangeShortcut" Tag="change-shortcut" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,19,0,0">
                    <Grid>
                        <StackPanel x:Name="ChangeShortcutContent" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.EditOutlined}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding [change_shortcut]}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="CancelShortcutContent" Text="{Binding [cancel]}" HorizontalAlignment="Center"/>
                    </Grid>
                </Button>
                <TextBlock x:Name="HotkeyStatus" FontSize="12" Foreground="{DynamicResource SettingsMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <Canvas x:Name="Step2Art">
                <Grid Canvas.Left="34" Canvas.Top="24" Width="214">
                    <Border Style="{StaticResource SampleScreen}" Height="178" VerticalAlignment="Top" ClipToBounds="True">
                        <Canvas>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SampleSelection}"/>
                            <Border Style="{StaticResource Floating}" Canvas.Left="10" Canvas.Top="117" CornerRadius="16" Padding="10,7">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Foreground="{DynamicResource OnboardingToolbarText}" Focusable="False">
                                        <Viewbox Width="14" Height="14">
                                            <Canvas Width="24" Height="24">
                                                <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.SearchOutlined}"/>
                                            </Canvas>
                                        </Viewbox>
                                    </ContentControl>
                                    <TextBlock x:Name="LensLabel" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource OnboardingToolbarText}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Border>
                    <Border Style="{StaticResource HintChip}" Margin="0,164,0,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{x:Static ui:PluginIcons.MouseLeftButtonOutlined}" Fill="{DynamicResource SettingsAccent}"/>
                                    <ContentControl Foreground="{DynamicResource OnboardingChipText}" Focusable="False">
                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.MouseOutlined}"/>
                                    </ContentControl>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding [left_click_hint]}" Style="{StaticResource ChipLabel}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Canvas.Left="272" Canvas.Top="24" Width="214">
                    <Border Style="{StaticResource SampleScreen}" Height="178" VerticalAlignment="Top" ClipToBounds="True">
                        <Canvas>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SampleSelection}"/>
                            <Border Style="{StaticResource Floating}" Canvas.Left="10" Canvas.Top="117" CornerRadius="18" Padding="6">
                                <ItemsControl x:Name="ToolbarIcons" Focusable="False" Foreground="{DynamicResource OnboardingToolbarText}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Viewbox Width="16" Height="16" Margin="5">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{Binding}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Canvas>
                    </Border>
                    <Border Style="{StaticResource HintChip}" Margin="0,164,0,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{x:Static ui:PluginIcons.MouseRightButtonOutlined}" Fill="{DynamicResource SettingsAccent}"/>
                                    <ContentControl Foreground="{DynamicResource OnboardingChipText}" Focusable="False">
                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.MouseOutlined}"/>
                                    </ContentControl>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding [right_click_hint]}" Style="{StaticResource ChipLabel}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Canvas>
            <Grid x:Name="Step3Art">
                <Canvas>
                <Border Style="{StaticResource SampleScreen}" Canvas.Left="60" Canvas.Top="30" Width="400" Height="136">
                    <StackPanel Margin="19,19,0,0" TextElement.FontSize="17" TextElement.FontWeight="Medium" TextElement.Foreground="{DynamicResource OnboardingScreenText}">
                        <TextBlock Text="{Binding [sample_line]}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding [sample_prefix]}" Margin="0,0,5,0"/>
                            <Border Background="{DynamicResource OnboardingTextHighlight}" CornerRadius="4" Padding="3,1">
                                <TextBlock Text="{Binding [sample_selected]}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Floating}" Canvas.Left="148" Canvas.Top="114" CornerRadius="18" Padding="6,5" BorderThickness="1" BorderBrush="{DynamicResource OnboardingToolbarBorder}">
                    <StackPanel Orientation="Horizontal" TextElement.FontSize="12" TextElement.FontWeight="Medium">
                        <ContentControl Foreground="{DynamicResource OnboardingToolbarText}" Focusable="False">
                            <StackPanel Orientation="Horizontal" Margin="10,5">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.CopyOutlined}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="CopyLabel" Foreground="{DynamicResource OnboardingToolbarText}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </ContentControl>
                        <ContentControl Foreground="{DynamicResource OnboardingToolbarText}" Focusable="False" Margin="2,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="10,5">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.SearchOutlined}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="SearchLabel" Foreground="{DynamicResource OnboardingToolbarText}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </Border>
                </Canvas>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,188,0,0" Height="30" Orientation="Horizontal" TextElement.FontSize="12">
                    <Border Style="{StaticResource Keycap}" BorderThickness="1,1,1,2" CornerRadius="5" Padding="8,0">
                        <TextBlock x:Name="AltLabel" FontWeight="Medium" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AltPlus" Foreground="{DynamicResource SettingsMuted}" Margin="6,0"/>
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="{x:Static ui:PluginIcons.MouseLeftButtonOutlined}" Fill="{DynamicResource SettingsAccent}"/>
                            <ContentControl Foreground="{DynamicResource SettingsMuted}" Focusable="False">
                                <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.MouseOutlined}"/>
                            </ContentControl>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding [alt_hint]}" Foreground="{DynamicResource SettingsMuted}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" ClipToBounds="True">
            <StackPanel x:Name="Step1Copy" Margin="28,22,28,8">
                <TextBlock Text="{Binding [step1_title]}" Style="{StaticResource StepTitle}"/>
                <TextBlock Text="{Binding [step1_text]}" Style="{StaticResource StepText}"/>
            </StackPanel>
            <StackPanel x:Name="Step2Copy" Margin="28,22,28,8">
                <TextBlock Text="{Binding [step2_title]}" Style="{StaticResource StepTitle}"/>
                <TextBlock Text="{Binding [step2_text]}" Style="{StaticResource StepText}"/>
            </StackPanel>
            <StackPanel x:Name="Step3Copy" Margin="28,22,28,8">
                <TextBlock Text="{Binding [step3_title]}" Style="{StaticResource StepTitle}"/>
                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="Step3Text" Text="{Binding [step3_text]}" Style="{StaticResource StepText}" Margin="0"/>
                    <TextBlock x:Name="LaunchFailed" Style="{StaticResource StepText}" Margin="0" Foreground="{DynamicResource SettingsAccent}" AutomationProperties.LiveSetting="Assertive"/>
                </Grid>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="2" Margin="28,18,20,20" LastChildFill="False">
            <StackPanel x:Name="Steps" Orientation="Horizontal" VerticalAlignment="Center" Margin="-3,0,0,0" DockPanel.Dock="Left">
                <Button Tag="step:0" Style="{StaticResource StepDot}"><Border Width="6" Height="6" CornerRadius="3"/></Button>
                <Button Tag="step:1" Style="{StaticResource StepDot}"><Border Width="6" Height="6" CornerRadius="3"/></Button>
                <Button Tag="step:2" Style="{StaticResource StepDot}"><Border Width="6" Height="6" CornerRadius="3"/></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <CheckBox x:Name="Launch" Style="{StaticResource Check}" VerticalAlignment="Center" Margin="0,0,8,0" IsChecked="True" Visibility="Collapsed" AutomationProperties.Name="{Binding [launch]}">
                    <TextBlock Text="{Binding [launch]}"/>
                </CheckBox>
                <Button x:Name="Skip" Tag="skip" Style="{StaticResource TextButton}">
                    <TextBlock Text="{Binding [skip]}"/>
                </Button>
                <Button x:Name="Back" Tag="back" Style="{StaticResource TextButton}" Visibility="Collapsed">
                    <TextBlock Text="{Binding [back]}"/>
                </Button>
                <Button x:Name="Next" Tag="next" Style="{StaticResource AccentButton}" Margin="8,0,0,0">
                    <TextBlock Text="{Binding [next]}"/>
                </Button>
                <Button x:Name="TryIt" Tag="try" Style="{StaticResource AccentButton}" Visibility="Collapsed">
                    <TextBlock Text="{Binding [try]}"/>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
