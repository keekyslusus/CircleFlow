<ContextMenu xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CircleToSearch.Ui"
             Placement="MousePoint" StaysOpen="False" HasDropShadow="False"
             Background="{DynamicResource TraySurface}" Foreground="{DynamicResource TrayText}"
             FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
             KeyboardNavigation.DirectionalNavigation="Cycle">
    <ContextMenu.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Highlight" CornerRadius="{x:Static ui:PluginShapes.SmallCorners}" Background="{DynamicResource TrayTransparent}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource TrayHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContextMenu.Resources>
    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Grid Margin="10">
                <Border CornerRadius="{x:Static ui:PluginShapes.MediumCorners}" Background="{TemplateBinding Background}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource TrayShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.18"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="MenuSurface" MinWidth="200" CornerRadius="{x:Static ui:PluginShapes.MediumCorners}" Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource TrayBorder}" BorderThickness="1" Padding="4">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </ControlTemplate>
    </ContextMenu.Template>
</ContextMenu>
