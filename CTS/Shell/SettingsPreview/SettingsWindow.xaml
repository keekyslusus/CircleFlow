                                        <ContentControl Grid.Column="2">
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.ChevronRightOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </ContentControl>
                                    </Grid>
                                </Button>
                            </UniformGrid>
                            <TextBlock Text="{Binding [application]}" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,0" Padding="19,17" MinHeight="77">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.PowerOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
