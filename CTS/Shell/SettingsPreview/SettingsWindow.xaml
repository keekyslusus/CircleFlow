                                            <ContentControl Grid.Column="3" VerticalAlignment="Center">
                                                <Button Tag="preview">
                                                    <TextBlock Text="{Binding [check_updates]}"/>
                                                </Button>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="19,17" MinHeight="77">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{StaticResource Icon_shield}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock Text="{Binding [open_source]}" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="{Binding [open_source_sub]}" Style="{StaticResource RowSubtitle}"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="3" VerticalAlignment="Center">
                                                <Button Tag="preview" Foreground="{DynamicResource SettingsAccent}">
