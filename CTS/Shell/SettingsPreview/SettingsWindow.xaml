                                                </Viewbox>
                                                <Border Width="8"/>
                                                <TextBlock Text="{Binding [feedback]}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding [details]}" Style="{StaticResource SectionTitle}"/>
