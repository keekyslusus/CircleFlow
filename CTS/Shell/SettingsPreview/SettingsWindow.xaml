                                                </Button>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="19,17" MinHeight="77">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.ShieldOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock Text="{Binding [open_source]}" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="{Binding [license]}" Style="{StaticResource RowSubtitle}"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="3" VerticalAlignment="Center">
                                                <Button Tag="license">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.LinkOutlined}"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <Border Width="8"/>
                                                        <TextBlock Text="{Binding [view_license]}"/>
                                                    </StackPanel>
                                                </Button>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="19,17" MinHeight="77">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.WindowOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock Text="{Binding [runtime]}" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="{Binding [runtime_sub]}" Style="{StaticResource RowSubtitle}"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock x:Name="RuntimeVersion" Foreground="{DynamicResource SettingsMuted}" FontSize="12"/>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="19,17" MinHeight="77">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.CoffeeOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock Text="{Binding [support]}" Style="{StaticResource RowTitle}"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="3" VerticalAlignment="Center">
                                                <Button Tag="donate">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.LinkOutlined}"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <Border Width="8"/>
                                                        <TextBlock Text="{Binding [donate]}"/>
                                                    </StackPanel>
                                                </Button>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,16,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,0" Padding="19,17" MinHeight="77">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="21"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.MaintenanceOutlined}"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                    <TextBlock Text="{Binding [maintenance]}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{Binding [maintenance_sub]}" Style="{StaticResource RowSubtitle}"/>
                                                </StackPanel>
                                                <ContentControl Grid.Column="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Tag="folder">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                                                    <Canvas Width="24" Height="24">
                                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.FolderOutlined}"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                                <Border Width="8"/>
                                                                <TextBlock Text="{Binding [folder]}"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Tag="logs" Margin="8,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                                                    <Canvas Width="24" Height="24">
                                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.LogsOutlined}"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                                <Border Width="8"/>
                                                                <TextBlock Text="{Binding [logs]}"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Tag="reset" Margin="8,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                                                    <Canvas Width="24" Height="24">
                                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.RestoreOutlined}"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                                <Border Width="8"/>
                                                                <TextBlock Text="{Binding [reset]}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </ContentControl>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding [powered_by]}" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Information}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [services_text]}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="Page_developer" Visibility="Collapsed">
                            <TextBlock Text="{Binding [developer_title]}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{Binding [developer_onboarding]}" Style="{StaticResource SectionTitle}" Margin="0,0,0,9"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,0" Padding="19,17" MinHeight="77">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.CircleSearchOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock Text="{Binding [show_onboarding]}" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="{Binding [show_onboarding_sub]}" Style="{StaticResource RowSubtitle}"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="3" VerticalAlignment="Center">
                                                <Button Tag="show-onboarding">
                                                    <TextBlock Text="{Binding [show]}"/>
                                                </Button>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding [developer_browser]}" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,0" Padding="19,17" MinHeight="77">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.GlobeOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock Text="{Binding [test_browser]}" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="{Binding [test_browser_sub]}" Style="{StaticResource RowSubtitle}"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="3" VerticalAlignment="Center">
                                                <Button Tag="test-browser">
                                                    <TextBlock Text="{Binding [open]}"/>
                                                </Button>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding [developer_notifications]}" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,0" Padding="19,17" MinHeight="77">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.InfoOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock Text="{Binding [test_notifications]}" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="{Binding [test_notifications_sub]}" Style="{StaticResource RowSubtitle}"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="3" VerticalAlignment="Center">
                                                <Button Tag="test-notifications">
                                                    <TextBlock Text="{Binding [show]}"/>
                                                </Button>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    </AdornerDecorator>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border x:Name="DialogLayer" Background="{DynamicResource SettingsTransparent}" Visibility="Collapsed" Focusable="True">
            <Grid>
            <Border x:Name="DialogScrim" Background="{DynamicResource SettingsScrim}" IsHitTestVisible="False"/>
            <AdornerDecorator x:Name="DialogMotionSurface" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Border x:Name="DialogCard" Width="440" MaxHeight="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource SettingsPaper}" BorderBrush="{DynamicResource SettingsLine}" BorderThickness="1" CornerRadius="9" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel Margin="24">
                    <StackPanel x:Name="ShortcutDialog">
                        <TextBlock Text="{Binding [new_shortcut]}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [open_selection]}" Style="{StaticResource Muted}" Margin="0,8,0,16"/>
                        <Border x:Name="ShortcutInput" Style="{StaticResource ShortcutRecorder}" Height="84" AutomationProperties.Name="{Binding [press_shortcut]}">
                            <Grid Margin="16,0">
                                <Viewbox StretchDirection="DownOnly" Height="39">
                                    <ItemsControl x:Name="ShortcutDraftKeys" Style="{StaticResource LargeKeys}" Focusable="False"/>
                                </Viewbox>
                                <TextBlock x:Name="ShortcutPrompt" FontSize="15" Foreground="{DynamicResource SettingsMuted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding [shortcut_instructions]}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="ResetDialog" Visibility="Collapsed">
                        <TextBlock Text="{Binding [reset_title]}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [reset_description]}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="ClearHistoryDialog" Visibility="Collapsed">
                        <TextBlock Text="{Binding [clear_history_title]}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [clear_history_description]}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="ProviderMenuDialog" Visibility="Collapsed">
                        <TextBlock Text="{Binding [provider_menu_title]}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [provider_menu_description]}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding [provider_menu_shown]}" FontWeight="SemiBold" Margin="0,16,0,9"/>
                        <Border Style="{StaticResource Card}">
                            <!-- Every row has a top divider; the clip hides the first one, whichever row that is mid-animation. -->
                            <Border ClipToBounds="True">
                                <StackPanel x:Name="ShownProviders" Margin="0,-1,0,0"/>
                            </Border>
                        </Border>
                        <StackPanel x:Name="HiddenProviderSection">
                            <TextBlock Text="{Binding [provider_menu_hidden]}" FontWeight="SemiBold" Margin="0,16,0,9"/>
                            <Border Style="{StaticResource Card}">
                                <Border ClipToBounds="True">
                                    <StackPanel x:Name="HiddenProviders" Margin="0,-1,0,0"/>
                                </Border>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Tag="cancel" x:Name="CancelDialog">
                            <TextBlock Text="{Binding [cancel]}"/>
                        </Button>
                        <Button Tag="save" x:Name="SaveShortcut" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0">
                            <TextBlock Text="{Binding [save]}"/>
                        </Button>
                        <Button Tag="confirm-reset" x:Name="ConfirmReset" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="{Binding [reset]}"/>
                        </Button>
                        <Button Tag="confirm-clear-history" x:Name="ConfirmClearHistory" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="{Binding [clear]}"/>
                        </Button>
                        <Button Tag="done" x:Name="DoneDialog" Style="{StaticResource PrimaryButton}" Visibility="Collapsed">
                            <TextBlock Text="{Binding [done]}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            </AdornerDecorator>
            </Grid>
        </Border>
        <!-- Above the dialog layer, so a save that fails inside a dialog is not dimmed by its scrim. -->
        <Border x:Name="StatusBanner" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="540" Background="{DynamicResource SettingsCard}" BorderBrush="{DynamicResource SettingsLine}" BorderThickness="1" CornerRadius="7" Padding="16,12" Margin="240,0,16,24">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </Border>
    </Grid>
</Window>
