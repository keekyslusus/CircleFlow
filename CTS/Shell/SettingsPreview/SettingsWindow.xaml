<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:CircleToSearch.Ui" Width="960" Height="590" MinWidth="960" MinHeight="590" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="{DynamicResource SettingsPaper}" Foreground="{DynamicResource SettingsText}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="HistoryActionsIn">
                <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static ui:UiAnimationPolicy.HoverFadeDuration}"/>
            </Storyboard>
            <Storyboard x:Key="HistoryActionsOut">
                <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static ui:UiAnimationPolicy.HoverFadeDuration}"/>
            </Storyboard>
            <DataTemplate x:Key="HistoryTrack">
                <Border x:Name="Row" BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="19,10,12,10" MinHeight="54" Background="{DynamicResource SettingsTransparent}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="5" Background="{DynamicResource SettingsHeroStart}" BorderBrush="{DynamicResource SettingsAccentLine}" BorderThickness="1">
                            <ContentControl Foreground="{DynamicResource SettingsAccent}" Focusable="False" IsTabStop="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.MusicOutlined}"/>
                                    </Canvas>
                                </Viewbox>
                            </ContentControl>
                        </Border>
                        <Border x:Name="Cover" Grid.Column="1" Width="32" Height="32" CornerRadius="5">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" Style="{StaticResource RowTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Artist}" ToolTip="{Binding Artist}" Style="{StaticResource RowSubtitle}" Margin="0,1,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border x:Name="Genre" Grid.Column="5" BorderBrush="{DynamicResource SettingsLine}" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Genre}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="Actions" Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0" Opacity="0">
                            <Button Tag="history-copy" Style="{StaticResource RowIconButton}" ToolTip="{DynamicResource HistoryCopyLabel}" AutomationProperties.Name="{DynamicResource HistoryCopyLabel}">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.CopyOutlined}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="Open" Tag="history-open" Style="{StaticResource RowIconButton}" Margin="2,0,0,0" ToolTip="{DynamicResource HistoryOpenLabel}" AutomationProperties.Name="{DynamicResource HistoryOpenLabel}">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.LinkOutlined}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter TargetName="Row" Property="BorderThickness" Value="0"/></DataTrigger>
                    <DataTrigger Binding="{Binding Genre}" Value="{x:Null}"><Setter TargetName="Genre" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding Cover}" Value="{x:Null}"><Setter TargetName="Cover" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding CanOpen}" Value="False"><Setter TargetName="Open" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HistoryActionsIn}"/></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HistoryActionsOut}"/></Trigger.ExitActions>
                    </Trigger>
                    <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                        <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HistoryActionsIn}"/></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HistoryActionsOut}"/></Trigger.ExitActions>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <DataTemplate x:Key="HistoryDay">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Margin="2,16,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource HistoryTrack}" Focusable="False"/>
                    </Border>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="ProviderMenuRow">
                <Border x:Name="Row" BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="16,8,12,8" MinHeight="53">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="Mark" Content="{Binding Mark}" Focusable="False" IsTabStop="False" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="Label" Text="{Binding Label}" Style="{StaticResource RowTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource RowSubtitle}" Margin="0,1,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border x:Name="AlwaysShown" Grid.Column="3" Visibility="Collapsed" BorderBrush="{DynamicResource SettingsLine}" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="12,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource ProviderAlwaysShownLabel}" Style="{StaticResource Muted}"/>
                        </Border>
                        <Button x:Name="Hide" Grid.Column="3" Tag="provider-hide" Style="{StaticResource TextButton}" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding HideLabel}">
                            <TextBlock Text="{DynamicResource ProviderHideLabel}"/>
                        </Button>
                        <Button x:Name="Show" Grid.Column="3" Tag="provider-show" Style="{StaticResource OutlinedTextButton}" Visibility="Collapsed" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding ShowLabel}">
                            <TextBlock Text="{DynamicResource ProviderShowLabel}"/>
                        </Button>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Shown}" Value="False">
                        <Setter TargetName="Mark" Property="Opacity" Value="0.45"/>
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
                        <Setter TargetName="Hide" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Show" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CanHide}" Value="False">
                        <Setter TargetName="Hide" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="AlwaysShown" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource SettingsPaper}">
        <Grid x:Name="Workspace" Background="{DynamicResource SettingsSidebar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SettingsSidebar}" Padding="12,13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="104"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource AppLogo}" CornerRadius="14" Width="48" Height="48" Margin="0,0,0,10">
                            <ContentControl Foreground="{DynamicResource SettingsAccent}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="29" Height="29">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.CircleSearchOutlined}"/>
                                    </Canvas>
                                </Viewbox>
                            </ContentControl>
                        </Border>
                        <TextBlock Text="{Binding [brand]}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Grid x:Name="NavigationHost" Grid.Row="1">
                        <Border x:Name="NavigationSelection" IsHitTestVisible="False" Visibility="Hidden" VerticalAlignment="Top" CornerRadius="5" Background="{DynamicResource SettingsSelected}">
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                            <Border Width="3" Margin="0,13" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource SettingsAccent}"/>
                        </Border>
                        <StackPanel x:Name="NavigationItems">
                            <RadioButton x:Name="Nav_general" AutomationProperties.Name="{Binding [general]}" Tag="general" GroupName="Pages" Style="{StaticResource NavigationItem}" IsChecked="False">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.HomeOutlined}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <ContentControl Content="{Binding [general]}" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Nav_hotkeys" AutomationProperties.Name="{Binding [hotkeys]}" Tag="hotkeys" GroupName="Pages" Style="{StaticResource NavigationItem}" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.KeyboardOutlined}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <ContentControl Content="{Binding [hotkeys]}" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Nav_search" AutomationProperties.Name="{Binding [search]}" Tag="search" GroupName="Pages" Style="{StaticResource NavigationItem}" IsChecked="False">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.SearchOutlined}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <ContentControl Content="{Binding [search]}" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Nav_text" AutomationProperties.Name="{Binding [text]}" Tag="text" GroupName="Pages" Style="{StaticResource NavigationItem}" IsChecked="False">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.TranslateOutlined}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <ContentControl Content="{Binding [text]}" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Nav_music" AutomationProperties.Name="{Binding [music]}" Tag="music" GroupName="Pages" Style="{StaticResource NavigationItem}" IsChecked="False">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.MusicOutlined}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <ContentControl Content="{Binding [music]}" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Nav_about" AutomationProperties.Name="{Binding [about]}" Tag="about" GroupName="Pages" Style="{StaticResource NavigationItem}" IsChecked="False">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.InfoOutlined}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <ContentControl Content="{Binding [about]}" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Nav_developer" AutomationProperties.Name="{Binding [developer]}" Tag="developer" GroupName="Pages" Style="{StaticResource NavigationItem}" IsChecked="False" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.MaintenanceOutlined}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <ContentControl Content="{Binding [developer]}" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="ContentSurface" Grid.Column="1" Background="{DynamicResource SettingsPaper}" BorderBrush="{DynamicResource SettingsLine}" BorderThickness="1,1,0,0" CornerRadius="9,0,0,0">
                <ScrollViewer x:Name="PageScroll" Style="{StaticResource PageScrollViewer}" BorderThickness="0" Background="{DynamicResource SettingsTransparent}" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <AdornerDecorator x:Name="PageTransitionSurface">
                    <StackPanel x:Name="PageContent" Margin="38,34,38,26">
                        <StackPanel.RenderTransform>
                            <TranslateTransform/>
                        </StackPanel.RenderTransform>
                        <StackPanel x:Name="Page_general" Visibility="Collapsed">
                            <TextBlock Text="{Binding [general_title]}" Style="{StaticResource PageTitle}"/>
                            <Border Style="{StaticResource Hero}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [brand]}" FontSize="19" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding [hero_description]}" Style="{StaticResource Muted}" MaxWidth="340" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,6,0,15"/>
                                        <ItemsControl x:Name="HeroShortcutKeys" Style="{StaticResource Keys}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Height="110">
                                        <Border Width="92" Height="92" CornerRadius="27" BorderThickness="1" BorderBrush="{DynamicResource SettingsAccentLine}" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-14"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border Width="68" Height="68" CornerRadius="19" Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource SettingsAccentLine}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="8"/>
                                            </Border.RenderTransform>
                                            <ContentControl Foreground="{DynamicResource SettingsAccent}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox Width="31" Height="31" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.CircleSearchOutlined}"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </ContentControl>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding [features]}" Style="{StaticResource SectionTitle}"/>
                            <UniformGrid Columns="2" Margin="-6,0,-6,0">
                                <Button Tag="page:search" Style="{StaticResource Feature}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="37"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="37" Height="37" CornerRadius="10" Background="{DynamicResource SettingsHeroStart}">
                                            <ContentControl Foreground="{DynamicResource SettingsAccent}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.SearchOutlined}"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </ContentControl>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,10,0">
                                            <TextBlock Text="{Binding [feature_search]}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{Binding [feature_search_sub]}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="2">
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.ChevronRightOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </ContentControl>
                                    </Grid>
                                </Button>
                                <Button Tag="page:text" Style="{StaticResource Feature}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="37"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="37" Height="37" CornerRadius="10" Background="{DynamicResource SettingsHeroStart}">
                                            <ContentControl Foreground="{DynamicResource SettingsAccent}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.TranslateOutlined}"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </ContentControl>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,10,0">
                                            <TextBlock Text="{Binding [feature_text]}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{Binding [feature_text_sub]}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="2">
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.ChevronRightOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </ContentControl>
                                    </Grid>
                                </Button>
                                <Button Tag="page:music" Style="{StaticResource Feature}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="37"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="37" Height="37" CornerRadius="10" Background="{DynamicResource SettingsHeroStart}">
                                            <ContentControl Foreground="{DynamicResource SettingsAccent}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.MusicOutlined}"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </ContentControl>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,10,0">
                                            <TextBlock Text="{Binding [feature_music]}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{Binding [feature_music_sub]}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="2">
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{x:Static ui:PluginIcons.ChevronRightOutlined}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </ContentControl>
                                    </Grid>
                                </Button>
