                                            <ContentControl Grid.Column="3" VerticalAlignment="Center">
                                                <Button Tag="preview">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Style="{StaticResource OutlineIcon}" Data="{StaticResource Icon_link}"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <Border Width="8"/>
                                                        <TextBlock Text="{Binding [kofi]}"/>
                                                    </StackPanel>
                                                </Button>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,16,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,0,0,0" Padding="19,17" MinHeight="77">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="21"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Style="{StaticResource OutlineIcon}" Data="{StaticResource Icon_maintenance}"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
