                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource OutlineIcon}" Data="{StaticResource Icon_coffee}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock Text="{Binding [support]}" Style="{StaticResource RowTitle}"/>
