<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CircleToSearch</RootNamespace>
    <AssemblyName>CircleFlow</AssemblyName>
    <Version>0.5.1</Version>
    <Product>CircleFlow</Product>
    <Title>CircleFlow</Title>
    <Description>Search a screen area visually or recognize music from Windows output</Description>
    <Authors>keekys</Authors>
    <Company>keekys</Company>
    <PackageProjectUrl>https://github.com/keekyslusus/circletosearchplugin</PackageProjectUrl>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputType>WinExe</OutputType>
    <StartupObject>CircleToSearch.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>CTS\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Precompiling the Windows SDK projection adds about 30 MB for code the app barely touches. -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Extensions\uBlockOriginLite.zip;Extensions\CircleFlowFilters.txt;Emoji\NotoColorEmoji.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Languages\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Page Remove="Languages\*.xaml" />
    <EmbeddedResource Include="Languages\en.xaml" LogicalName="CircleToSearch.Languages.en.xaml" />
    <Content Include="CTS\app.ico" Link="Images\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="poc\**\*.cs" />
    <ApplicationDefinition Remove="tests\**\*.xaml" />
    <Page Remove="tests\**\*.xaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(UpdateFeed)' != ''">
    <AssemblyMetadata Include="UpdateFeed" Value="$(UpdateFeed)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UpdateRepository)' != ''">
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CircleToSearch.Tests" />
    <InternalsVisibleTo Include="CircleFlow.PublishProbe" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="THIRD_PARTY_NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="THIRD_PARTY_LICENSES\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.4129.50\LICENSE.txt"
             Link="THIRD_PARTY_LICENSES\Microsoft.Web.WebView2.LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.4129.50\NOTICE.txt"
             Link="THIRD_PARTY_LICENSES\Microsoft.Web.WebView2.NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)system.numerics.tensors\9.0.0\THIRD-PARTY-NOTICES.TXT"
             Link="THIRD_PARTY_LICENSES\System.Numerics.Tensors.NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ArrangePublishedDependencies" AfterTargets="ComputeFilesToPublish">
    <Error Condition="'PublishSingleFile' == 'true'" Text="The deps layout requires PublishSingleFile=false." />
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.xml' and Exists('%(RootDir)%(Directory)%(Filename).dll')" />
      <ResolvedFileToPublish Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '^(Images|Languages|Extensions|Emoji|THIRD_PARTY_LICENSES)[/\\]|^(CircleFlow\.exe|LICENSE|THIRD_PARTY_NOTICES\.txt)$'))">
        <RelativePath>deps\%(RelativePath)</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="CreatePublishedAppHost" AfterTargets="Publish">
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(PublishDir)$(AssemblyName).exe"
                   AppBinaryName="deps\$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="true"
                   DisableCetCompat="$(_DisableCetCompat)" />
  </Target>

</Project>
